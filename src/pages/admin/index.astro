---
import Base from '../../layouts/Base.astro';
---
<Base title="Painel — Zapdafé Admin" description="Estatísticas e opt-outs">
  <Fragment slot="head">
    <meta name="robots" content="noindex, nofollow" />
    <style>
      /* Dark warm override for admin page only */
      body {
        background: #141210 !important;
        color: #F5EFE4 !important;
      }
    </style>
  </Fragment>

  <div class="admin-shell">
    <!-- Background -->
    <div class="admin-bg" aria-hidden="true">
      <div class="admin-bg-orb orb-1"></div>
      <div class="admin-bg-orb orb-2"></div>
    </div>

    <!-- Header -->
    <header class="admin-header">
      <div class="admin-header-inner">
        <div class="admin-brand">
          <img src="/logo.svg" alt="Zapdafé" class="admin-logo" />
          <span class="admin-brand-sep">/</span>
          <span class="admin-brand-label">Admin</span>
        </div>
        <div class="admin-header-actions">
          <button id="refresh-btn" class="admin-btn admin-btn-ghost" aria-label="Atualizar dados">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
            Atualizar
          </button>
          <button id="logout-btn" class="admin-btn admin-btn-ghost" aria-label="Sair do painel">
            Sair
          </button>
        </div>
      </div>
    </header>

    <main class="admin-main">
      <!-- Page title -->
      <div class="admin-page-title">
        <div>
          <h1 class="admin-h1">Painel</h1>
          <p id="last-updated" class="admin-subtitle">
            <span class="live-dot" aria-hidden="true"></span>
            <span id="last-updated-text">Sincronizando…</span>
          </p>
        </div>
        <a href="#optouts" class="admin-link-subtle">
          Ir para opt-outs
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
        </a>
      </div>

      <!-- Skeleton (first load) -->
      <div id="skeleton" class="skeleton-shell" role="status" aria-live="polite" aria-label="Carregando painel">
        <div class="skeleton-grid">
          <div class="skel-card"></div>
          <div class="skel-card skel-card--wide"></div>
          <div class="skel-card"></div>
        </div>
        <div class="skel-block skel-block--table"></div>
        <div class="skel-block skel-block--peaks"></div>
      </div>
      <div id="error" class="admin-error hidden" role="alert"></div>

      <!-- Content -->
      <div id="content" class="hidden admin-content">

        <!-- Totals (cumulative, never shrink) -->
        <section aria-labelledby="totals-h">
          <h2 id="totals-h" class="sr-only">Totais acumulados</h2>
          <div class="totals-grid">
            <div class="total-card total-card--gold">
              <div class="total-head">
                <div class="total-icon" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                </div>
                <span class="total-delta" id="delta-people" aria-hidden="true"></span>
              </div>
              <div class="total-label">Pessoas atendidas</div>
              <div class="total-value" id="total-people" data-target="0">–</div>
              <div class="total-foot">
                <span class="total-hint">acumulado</span>
                <svg class="total-spark" id="spark-people" viewBox="0 0 120 32" preserveAspectRatio="none" aria-hidden="true"></svg>
              </div>
            </div>
            <div class="total-card total-card--green">
              <div class="total-head">
                <div class="total-icon" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                </div>
                <span class="total-delta" id="delta-messages" aria-hidden="true"></span>
              </div>
              <div class="total-label">Mensagens trocadas</div>
              <div class="total-value" id="total-messages" data-target="0">–</div>
              <div class="total-foot">
                <span class="total-hint">acumulado</span>
                <svg class="total-spark total-spark--green" id="spark-messages" viewBox="0 0 120 32" preserveAspectRatio="none" aria-hidden="true"></svg>
              </div>
            </div>
            <div class="total-card">
              <div class="total-head">
                <div class="total-icon" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg>
                </div>
              </div>
              <div class="total-label">Opt-outs</div>
              <div class="total-value" id="total-optouts" data-target="0">–</div>
              <div class="total-foot">
                <span class="total-hint">saíram da lista</span>
              </div>
            </div>
          </div>
        </section>

        <!-- Períodos -->
        <section aria-labelledby="periods-h">
          <div class="admin-section-header">
            <h2 id="periods-h" class="admin-h2">Por período</h2>
          </div>
          <div class="table-card">
            <div class="table-wrap">
              <table class="admin-table periods-table">
                <thead>
                  <tr>
                    <th>Período</th>
                    <th class="th-num">Mensagens</th>
                    <th class="th-num">Pessoas novas</th>
                    <th class="th-num">Pessoas ativas</th>
                  </tr>
                </thead>
                <tbody id="periods-body"></tbody>
              </table>
            </div>
          </div>
        </section>

        <!-- Peaks heatmap -->
        <section aria-labelledby="peaks-h">
          <div class="admin-section-header">
            <div>
              <h2 id="peaks-h" class="admin-h2">Picos por horário</h2>
              <p class="peaks-sub" id="peaks-sub">–</p>
            </div>
          </div>
          <div class="peaks-card">
            <div class="peaks-header">
              <div class="peaks-corner"></div>
              <div class="peaks-hours" id="peaks-hours"></div>
            </div>
            <div class="peaks-body">
              <div class="peaks-days" id="peaks-days"></div>
              <div class="peaks-grid" id="peaks-grid" role="img" aria-label="Heatmap de mensagens recebidas por dia da semana e hora"></div>
            </div>
            <div class="peaks-scale">
              <span>Menos</span>
              <div class="peaks-scale-gradient"></div>
              <span>Mais</span>
            </div>
          </div>
        </section>

        <!-- Recent -->
        <section aria-labelledby="recent-h">
          <div class="admin-section-header">
            <h2 id="recent-h" class="admin-h2">Últimas atividades</h2>
          </div>
          <div class="table-card">
            <div class="table-wrap">
              <table class="admin-table">
                <thead>
                  <tr>
                    <th>Contato</th>
                    <th>Mensagens</th>
                    <th>Última</th>
                    <th>Iniciou</th>
                    <th>Ação</th>
                  </tr>
                </thead>
                <tbody id="recent-body"></tbody>
              </table>
            </div>
          </div>
        </section>

        <!-- Opt-outs -->
        <section id="optouts" aria-labelledby="optouts-h">
          <div class="admin-section-header">
            <h2 id="optouts-h" class="admin-h2">Opt-outs</h2>
          </div>
          <div class="glass-card">
            <form id="optout-add" class="optout-form">
              <input
                type="text"
                id="optout-phone"
                placeholder="55DD9XXXXXXXX (só dígitos)"
                class="admin-input"
                autocomplete="off"
                inputmode="numeric"
              />
              <button type="submit" class="admin-btn admin-btn-primary">
                Adicionar opt-out
              </button>
            </form>
            <div id="optout-list" class="optout-list"></div>
          </div>
        </section>

        <p class="admin-footer-note">
          Filtro ativo: mensagens desde <strong id="cutoff-label">–</strong>.
        </p>
        <p class="admin-footer-note" id="debug-note" style="opacity:.5"></p>
      </div>
    </main>
  </div>

  <style>
    /* ── Reset / base ───────────────────────────────── */
    .sr-only { position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0 }

    /* ── Browser surfaces (the parts we didn't draw) ── */
    ::selection { background: rgba(184, 134, 11, 0.35); color: #F5EFE4; }
    :focus-visible { outline: 2px solid #B8860B; outline-offset: 2px; border-radius: 4px; }
    /* Firefox scrollbar */
    * { scrollbar-width: thin; scrollbar-color: rgba(184,134,11,0.35) transparent; }
    /* WebKit scrollbar */
    *::-webkit-scrollbar { width: 10px; height: 10px; }
    *::-webkit-scrollbar-track { background: transparent; }
    *::-webkit-scrollbar-thumb {
      background: rgba(184,134,11,0.25);
      border-radius: 999px;
      border: 2px solid transparent;
      background-clip: padding-box;
    }
    *::-webkit-scrollbar-thumb:hover { background: rgba(184,134,11,0.5); background-clip: padding-box; }

    /* Tabular numerals everywhere data lives */
    .total-value, .period-num, .td-count, .kpi-value,
    #cutoff-label, #last-updated-text, .td-date, .td-msgs-detail,
    .peaks-hours, .optout-row { font-variant-numeric: tabular-nums; font-feature-settings: "tnum" 1; }

    /* ── Shell & background ─────────────────────────── */
    .admin-shell {
      position: relative;
      min-height: 100vh;
      background: #141210;
      overflow-x: hidden;
    }
    .admin-bg {
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 0;
    }
    .admin-bg-orb {
      position: absolute;
      border-radius: 50%;
      filter: blur(120px);
      opacity: 0.18;
    }
    .orb-1 {
      width: 600px; height: 600px;
      background: radial-gradient(circle, #B8860B 0%, transparent 70%);
      top: -200px; right: -100px;
    }
    .orb-2 {
      width: 500px; height: 500px;
      background: radial-gradient(circle, #25D366 0%, transparent 70%);
      bottom: -100px; left: -150px;
    }

    /* ── Header ─────────────────────────────────────── */
    .admin-header {
      position: sticky;
      top: 0;
      z-index: 30;
      background: rgba(20, 18, 16, 0.75);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border-bottom: 1px solid rgba(184, 134, 11, 0.2);
    }
    .admin-header-inner {
      max-width: 1280px;
      margin: 0 auto;
      padding: 0 1.5rem;
      height: 64px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .admin-brand {
      display: flex;
      align-items: center;
      gap: 0.625rem;
    }
    .admin-logo {
      height: 32px;
      width: auto;
      filter: brightness(0) invert(1);
      opacity: 0.9;
    }
    .admin-brand-sep {
      color: rgba(245, 239, 228, 0.25);
      font-size: 1rem;
    }
    .admin-brand-label {
      font-size: 0.8125rem;
      font-weight: 500;
      color: rgba(245, 239, 228, 0.45);
      letter-spacing: 0.04em;
    }
    .admin-header-actions {
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    /* ── Buttons ─────────────────────────────────────── */
    .admin-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.375rem;
      font-size: 0.8125rem;
      font-weight: 500;
      padding: 0.4375rem 0.875rem;
      border-radius: 999px;
      cursor: pointer;
      transition: all 0.18s ease;
      border: none;
      text-decoration: none;
    }
    .admin-btn:focus-visible {
      outline: 2px solid #B8860B;
      outline-offset: 2px;
    }
    .admin-btn-ghost {
      background: rgba(245, 239, 228, 0.06);
      color: rgba(245, 239, 228, 0.6);
      border: 1px solid rgba(245, 239, 228, 0.1);
    }
    .admin-btn-ghost:hover {
      background: rgba(245, 239, 228, 0.1);
      color: #F5EFE4;
      border-color: rgba(245, 239, 228, 0.2);
    }
    .admin-btn-primary {
      background: #B8860B;
      color: #141210;
      font-weight: 600;
    }
    .admin-btn-primary:hover {
      background: #D4A017;
    }
    .admin-btn-sm {
      font-size: 0.75rem;
      padding: 0.3125rem 0.75rem;
    }
    .admin-btn-danger {
      background: rgba(239, 68, 68, 0.1);
      color: #FCA5A5;
      border: 1px solid rgba(239, 68, 68, 0.25);
    }
    .admin-btn-danger:hover {
      background: rgba(239, 68, 68, 0.2);
    }
    .admin-btn-optout {
      background: rgba(184, 134, 11, 0.12);
      color: #D4A017;
      border: 1px solid rgba(184, 134, 11, 0.3);
    }
    .admin-btn-optout:hover {
      background: rgba(184, 134, 11, 0.22);
    }
    .admin-btn-optout-active {
      background: rgba(184, 134, 11, 0.25);
      color: #F5EFE4;
      border: 1px solid rgba(184, 134, 11, 0.5);
    }

    /* ── Main layout ─────────────────────────────────── */
    .admin-main {
      position: relative;
      z-index: 1;
      max-width: 1280px;
      margin: 0 auto;
      padding: 2.5rem 1.5rem 4rem;
    }

    /* ── Page title ──────────────────────────────────── */
    .admin-page-title {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 1rem;
      margin-bottom: 2rem;
    }
    .admin-h1 {
      font-family: "Fraunces", serif;
      font-weight: 700;
      font-size: clamp(1.75rem, 4vw, 2.5rem);
      color: #F5EFE4;
      line-height: 1.1;
    }
    .admin-subtitle {
      font-size: 0.75rem;
      color: rgba(245, 239, 228, 0.4);
      margin-top: 0.25rem;
    }
    .admin-link-subtle {
      display: inline-flex;
      align-items: center;
      gap: 0.25rem;
      font-size: 0.8125rem;
      color: rgba(245, 239, 228, 0.4);
      text-decoration: none;
      transition: color 0.15s;
      white-space: nowrap;
      margin-top: 0.5rem;
    }
    .admin-link-subtle:hover { color: #B8860B; }

    /* ── Skeleton (first-load) ──────────────────────── */
    .skeleton-shell { display: flex; flex-direction: column; gap: 2.5rem; }
    .skeleton-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 0.875rem;
    }
    @media (min-width: 640px) { .skeleton-grid { grid-template-columns: repeat(3, 1fr); } }
    .skel-card { height: 172px; border-radius: 1.25rem; }
    .skel-card, .skel-block {
      background: linear-gradient(
        100deg,
        rgba(245,239,228,0.04) 0%,
        rgba(184,134,11,0.10) 45%,
        rgba(245,239,228,0.04) 90%
      );
      background-size: 200% 100%;
      animation: shimmer 1.6s ease-in-out infinite;
      border: 1px solid rgba(184,134,11,0.10);
    }
    .skel-block--table { height: 240px; border-radius: 1.25rem; }
    .skel-block--peaks { height: 260px; border-radius: 1.25rem; }
    @keyframes shimmer {
      0% { background-position: 200% 0; }
      100% { background-position: -200% 0; }
    }
    .skeleton-shell.hidden { display: none; }

    /* Live pulse (header status) */
    .live-dot {
      display: inline-block;
      width: 6px; height: 6px;
      border-radius: 50%;
      background: #25D366;
      box-shadow: 0 0 0 0 rgba(37, 211, 102, 0.55);
      animation: livepulse 2.2s ease-out infinite;
      margin-right: 0.375rem;
      vertical-align: 1px;
    }
    .live-dot.stale { background: rgba(245,239,228,0.35); animation: none; box-shadow: none; }
    @keyframes livepulse {
      0%   { box-shadow: 0 0 0 0 rgba(37, 211, 102, 0.55); }
      70%  { box-shadow: 0 0 0 8px rgba(37, 211, 102, 0); }
      100% { box-shadow: 0 0 0 0 rgba(37, 211, 102, 0); }
    }

    .admin-error {
      background: rgba(239, 68, 68, 0.08);
      border: 1px solid rgba(239, 68, 68, 0.25);
      border-radius: 1rem;
      padding: 1rem 1.25rem;
      color: #FCA5A5;
      font-size: 0.875rem;
    }

    /* ── Content spacing ─────────────────────────────── */
    .admin-content { display: flex; flex-direction: column; gap: 2.5rem; }

    /* ── Section headers ─────────────────────────────── */
    .admin-section-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 0.875rem;
    }
    .admin-h2 {
      font-family: "Fraunces", serif;
      font-weight: 700;
      font-size: 1.125rem;
      color: #F5EFE4;
    }

    /* ── Glass card base ─────────────────────────────── */
    .glass-card {
      background: rgba(245, 239, 228, 0.04);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(184, 134, 11, 0.2);
      border-radius: 1.25rem;
      padding: 1.5rem;
    }

    /* ── Totals grid (cumulative) ────────────────────── */
    .totals-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 0.875rem;
    }
    @media (min-width: 640px) { .totals-grid { grid-template-columns: repeat(3, 1fr); } }

    .total-card {
      position: relative;
      background: rgba(245, 239, 228, 0.05);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
      border: 1px solid rgba(184, 134, 11, 0.2);
      border-radius: 1.25rem;
      padding: 1.375rem 1.5rem 1.25rem;
      overflow: hidden;
      box-shadow:
        0 1px 0 rgba(245, 239, 228, 0.04) inset,
        0 8px 24px -12px rgba(0, 0, 0, 0.4);
      transition: transform .28s cubic-bezier(.2,.7,.2,1), box-shadow .28s ease, border-color .28s ease;
    }
    .total-card:hover {
      transform: translateY(-2px);
      box-shadow:
        0 1px 0 rgba(245, 239, 228, 0.06) inset,
        0 18px 40px -18px rgba(0, 0, 0, 0.55);
    }
    /* Warm corner glow */
    .total-card::after {
      content: '';
      position: absolute;
      top: 0; right: 0;
      width: 120px; height: 120px;
      background: radial-gradient(circle at top right, rgba(184,134,11,0.18), transparent 70%);
      pointer-events: none;
    }
    /* Single specular sheen — the one authored moment on load */
    .total-card::before {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(115deg, transparent 30%, rgba(245,239,228,0.10) 50%, transparent 70%);
      transform: translateX(-120%);
      pointer-events: none;
    }
    .revealed .total-card::before {
      animation: sheen 1.4s cubic-bezier(.2,.7,.2,1) 0.35s both;
    }
    .revealed .total-card:nth-child(2)::before { animation-delay: 0.5s; }
    .revealed .total-card:nth-child(3)::before { animation-delay: 0.65s; }
    @keyframes sheen {
      to { transform: translateX(120%); }
    }

    .total-card--gold {
      border-color: rgba(184, 134, 11, 0.4);
      background: linear-gradient(135deg, rgba(184,134,11,0.09), rgba(245,239,228,0.03));
    }
    .total-card--gold:hover { border-color: rgba(184, 134, 11, 0.6); }
    .total-card--green {
      border-color: rgba(37, 211, 102, 0.28);
      background: linear-gradient(135deg, rgba(37,211,102,0.06), rgba(245,239,228,0.03));
    }
    .total-card--green:hover { border-color: rgba(37, 211, 102, 0.5); }
    .total-card--green::after {
      background: radial-gradient(circle at top right, rgba(37,211,102,0.15), transparent 70%);
    }

    .total-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 0.5rem;
    }
    .total-icon {
      display: inline-flex;
      color: rgba(184, 134, 11, 0.85);
      padding: 0.5rem;
      background: rgba(184, 134, 11, 0.10);
      border-radius: 0.625rem;
      border: 1px solid rgba(184, 134, 11, 0.18);
    }
    .total-card--green .total-icon {
      color: rgba(37, 211, 102, 0.95);
      background: rgba(37, 211, 102, 0.10);
      border-color: rgba(37, 211, 102, 0.22);
    }
    .total-delta {
      font-size: 0.6875rem;
      font-weight: 600;
      padding: 0.1875rem 0.5rem;
      border-radius: 999px;
      color: rgba(245, 239, 228, 0.55);
      background: rgba(245, 239, 228, 0.06);
      border: 1px solid rgba(245, 239, 228, 0.08);
      letter-spacing: 0.01em;
      font-variant-numeric: tabular-nums;
      opacity: 0;
      transform: translateY(-2px);
      transition: opacity .3s ease, transform .3s ease;
    }
    .total-delta.show { opacity: 1; transform: translateY(0); }
    .total-delta.up { color: #7BE29C; background: rgba(37, 211, 102, 0.10); border-color: rgba(37, 211, 102, 0.28); }
    .total-delta.flat { color: rgba(245, 239, 228, 0.4); }

    .total-label {
      font-size: 0.6875rem;
      color: rgba(245, 239, 228, 0.55);
      text-transform: uppercase;
      letter-spacing: 0.08em;
      font-weight: 600;
    }
    .total-value {
      font-family: "Fraunces", serif;
      font-weight: 700;
      font-size: clamp(2.25rem, 5vw, 3rem);
      line-height: 1;
      color: #F5EFE4;
      margin-top: 0.375rem;
      letter-spacing: -0.02em;
    }
    .total-foot {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 0.75rem;
      margin-top: 0.75rem;
    }
    .total-hint {
      font-size: 0.6875rem;
      color: rgba(245, 239, 228, 0.35);
      font-style: italic;
    }

  </style>

  <script>
    interface StatsResponse {
      cutoffISO: string;
      generatedAtISO: string;
      totals: {
        peopleEver: number;
        messagesEver: number;
        optedOutCount: number;
      };
      periods: Array<{
        label: string;
        messages: number;
        newContacts: number;
        activeContacts: number;
      }>;
      people: {
        total: number;
        activeLast24h: number;
        activeLast7d: number;
        activeLast30d: number;
        startedToday: number;
        optedOutCount: number;
      };
      messages: {
        totalSinceCutoff: number;
        today: number;
        last7d: number;
        last30d: number;
        incomingToday: number;
        outgoingToday: number;
      };
      daily: Array<{ date: string; incoming: number; outgoing: number; startedConvos: number }>;
      peaks: {
        grid: number[][];
        maxCell: number;
        totalIncoming: number;
        totalOutgoing: number;
        topHour: { day: number; hour: number; count: number };
      };
      debug?: {
        pagesFetched: number;
        hitPageCap: boolean;
        uazapiHasMore: boolean;
        totalMessagesFetched: number;
        oldestFetchedISO: string | null;
      };
      recent: Array<{
        chatid: string;
        name: string;
        firstMsgAt: number;
        lastMsgAt: number;
        msgsIn: number;
        msgsOut: number;
        msgsTotal: number;
        optedOut: boolean;
      }>;
    }

    function fmtDate(ms: number): string {
      return new Date(ms).toLocaleString('pt-BR', { timeZone: 'America/Sao_Paulo', dateStyle: 'short', timeStyle: 'short' });
    }
    function fmtDateShort(iso: string): string {
      return new Date(iso).toLocaleDateString('pt-BR', { timeZone: 'America/Sao_Paulo', day: '2-digit', month: '2-digit' });
    }
    function fmtRelative(ms: number): string {
      const diff = Date.now() - ms;
      if (diff < 45_000) return 'agora mesmo';
      if (diff < 90_000) return 'há 1 min';
      if (diff < 3_600_000) return `há ${Math.round(diff / 60_000)} min`;
      if (diff < 86_400_000) return `há ${Math.round(diff / 3_600_000)} h`;
      return fmtDate(ms);
    }
    function phoneFromChatId(chatid: string): string {
      const d = chatid.split('@')[0];
      if (d.length >= 12) return `+${d.slice(0,2)} ${d.slice(2,4)} ${d.slice(4)}`;
      return d;
    }
    function escapeHtml(s: string): string {
      return s.replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]!));
    }
    /** Deterministic hue 0-360 from a string. Skips reds/browns to keep palette warm-neutral. */
    function hueFromString(s: string): number {
      let h = 0;
      for (let i = 0; i < s.length; i++) h = (h * 31 + s.charCodeAt(i)) >>> 0;
      // avoid pure red band (0-15) which clashes with the gold accent
      return 15 + (h % 330);
    }

    let lastGeneratedMs: number | null = null;
    let relativeTimer: number | null = null;

    function updateLastUpdated() {
      if (lastGeneratedMs === null) return;
      const el = document.getElementById('last-updated-text')!;
      el.textContent = 'Atualizado ' + fmtRelative(lastGeneratedMs);
      const dot = document.querySelector('.live-dot');
      if (dot) {
        const stale = Date.now() - lastGeneratedMs > 15 * 60_000;
        dot.classList.toggle('stale', stale);
      }
    }

    async function loadStats() {
      const skeleton = document.getElementById('skeleton')!;
      const errorEl = document.getElementById('error')!;
      const content = document.getElementById('content')!;
      const isFirstLoad = content.classList.contains('hidden');
      if (isFirstLoad) {
        skeleton.classList.remove('hidden');
        content.classList.add('hidden');
      }
      errorEl.classList.add('hidden');
      try {
        const res = await fetch('/api/admin/stats', { credentials: 'same-origin' });
        if (res.status === 401) { window.location.href = '/admin-login'; return; }
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        renderStats(await res.json() as StatsResponse, isFirstLoad);
      } catch (err) {
        errorEl.textContent = 'Falha ao carregar estatísticas: ' + (err instanceof Error ? err.message : String(err));
        errorEl.classList.remove('hidden');
      } finally {
        skeleton.classList.add('hidden');
      }
    }

    function fmtInt(n: number): string {
      return n.toLocaleString('pt-BR');
    }

    /** Animate integer count-up to target. Fast start, ease-out. */
    function animateCount(el: HTMLElement, target: number, durationMs = 900) {
      if (matchMedia('(prefers-reduced-motion: reduce)').matches || target === 0) {
        el.textContent = fmtInt(target); return;
      }
      const start = performance.now();
      const from = 0;
      function tick(t: number) {
        const p = Math.min(1, (t - start) / durationMs);
        const eased = 1 - Math.pow(1 - p, 3);
        const v = Math.round(from + (target - from) * eased);
        el.textContent = fmtInt(v);
        if (p < 1) requestAnimationFrame(tick);
      }
      requestAnimationFrame(tick);
    }

    /** Draw a smooth sparkline path into an <svg viewBox="0 0 120 32">. */
    function drawSparkline(svgId: string, values: number[], fillId: string) {
      const svg = document.getElementById(svgId) as SVGSVGElement | null;
      if (!svg) return;
      svg.innerHTML = '';
      if (values.length < 2) return;
      const W = 120, H = 32, PAD_Y = 3;
      const max = Math.max(1, ...values);
      const min = 0;
      const range = max - min || 1;
      const step = W / (values.length - 1);
      const pts = values.map((v, i) => {
        const x = i * step;
        const y = H - PAD_Y - ((v - min) / range) * (H - PAD_Y * 2);
        return [x, y] as const;
      });
      // Catmull-Rom → Bezier
      function toPath(points: readonly (readonly [number, number])[]): string {
        if (points.length < 2) return '';
        let d = `M ${points[0][0]} ${points[0][1]}`;
        for (let i = 0; i < points.length - 1; i++) {
          const p0 = points[i - 1] || points[i];
          const p1 = points[i];
          const p2 = points[i + 1];
          const p3 = points[i + 2] || p2;
          const cp1x = p1[0] + (p2[0] - p0[0]) / 6;
          const cp1y = p1[1] + (p2[1] - p0[1]) / 6;
          const cp2x = p2[0] - (p3[0] - p1[0]) / 6;
          const cp2y = p2[1] - (p3[1] - p1[1]) / 6;
          d += ` C ${cp1x} ${cp1y}, ${cp2x} ${cp2y}, ${p2[0]} ${p2[1]}`;
        }
        return d;
      }
      const linePath = toPath(pts);
      const areaPath = `${linePath} L ${W} ${H} L 0 ${H} Z`;
      const ns = 'http://www.w3.org/2000/svg';
      // gradient def
      const defs = document.createElementNS(ns, 'defs');
      const grad = document.createElementNS(ns, 'linearGradient');
      grad.setAttribute('id', fillId);
      grad.setAttribute('x1', '0'); grad.setAttribute('x2', '0');
      grad.setAttribute('y1', '0'); grad.setAttribute('y2', '1');
      const isGreen = fillId.includes('green');
      const c1 = isGreen ? 'rgba(37,211,102,0.45)' : 'rgba(184,134,11,0.45)';
      const c2 = isGreen ? 'rgba(37,211,102,0)' : 'rgba(184,134,11,0)';
      grad.innerHTML = `<stop offset="0%" stop-color="${c1}"/><stop offset="100%" stop-color="${c2}"/>`;
      defs.appendChild(grad);
      svg.appendChild(defs);
      const area = document.createElementNS(ns, 'path');
      area.setAttribute('d', areaPath);
      area.setAttribute('class', 'spark-area');
      area.setAttribute('fill', `url(#${fillId})`);
      svg.appendChild(area);
      const line = document.createElementNS(ns, 'path');
      line.setAttribute('d', linePath);
      line.setAttribute('class', 'spark-line');
      svg.appendChild(line);
    }

    /** Build daily message totals array (last 30 days) from daily rollup. */
    function buildDailyMessages(daily: StatsResponse['daily'], days = 30): number[] {
      const map = new Map(daily.map(d => [d.date, d.incoming + d.outgoing]));
      const out: number[] = [];
      const today = new Date();
      for (let i = days - 1; i >= 0; i--) {
        const d = new Date(today);
        d.setDate(today.getDate() - i);
        const key = d.toISOString().slice(0, 10);
        out.push(map.get(key) ?? 0);
      }
      return out;
    }

    function buildDailyNewPeople(daily: StatsResponse['daily'], days = 30): number[] {
      const map = new Map(daily.map(d => [d.date, d.startedConvos ?? 0]));
      const out: number[] = [];
      const today = new Date();
      for (let i = days - 1; i >= 0; i--) {
        const d = new Date(today);
        d.setDate(today.getDate() - i);
        const key = d.toISOString().slice(0, 10);
        out.push(map.get(key) ?? 0);
      }
      return out;
    }

    function setDelta(id: string, todayVal: number, yesterdayVal: number) {
      const el = document.getElementById(id);
      if (!el) return;
      if (todayVal <= 0 && yesterdayVal <= 0) return;
      const cls = todayVal > yesterdayVal ? 'up' : todayVal === yesterdayVal ? 'flat' : '';
      el.classList.add('show');
      if (cls) el.classList.add(cls);
      if (todayVal > yesterdayVal) el.textContent = `+${fmtInt(todayVal)} hoje`;
      else if (todayVal === 0) el.textContent = 'sem novas hoje';
      else el.textContent = `${fmtInt(todayVal)} hoje`;
    }

    function renderStats(data: StatsResponse, isFirstLoad: boolean) {
      const content = document.getElementById('content')!;
      content.classList.remove('hidden');

      // Totals with count-up (only first load animates; subsequent refreshes snap)
      const peopleEl = document.getElementById('total-people')!;
      const msgsEl = document.getElementById('total-messages')!;
      const optsEl = document.getElementById('total-optouts')!;
      if (isFirstLoad) {
        animateCount(peopleEl, data.totals.peopleEver);
        animateCount(msgsEl, data.totals.messagesEver, 1100);
        animateCount(optsEl, data.totals.optedOutCount, 700);
      } else {
        peopleEl.textContent = fmtInt(data.totals.peopleEver);
        msgsEl.textContent = fmtInt(data.totals.messagesEver);
        optsEl.textContent = fmtInt(data.totals.optedOutCount);
      }

      // Sparklines from real daily data
      const dailyMsgs = buildDailyMessages(data.daily);
      const dailyNew = buildDailyNewPeople(data.daily);
      drawSparkline('spark-messages', dailyMsgs, 'spark-fill-green');
      drawSparkline('spark-people', dailyNew, 'spark-fill-gold');

      // Deltas (today vs yesterday)
      const yestKey = new Date(Date.now() - 86_400_000).toISOString().slice(0, 10);
      const todayRow = data.daily[data.daily.length - 1];
      const yestRow = data.daily.find(d => d.date === yestKey);
      setDelta('delta-messages',
        (todayRow ? todayRow.incoming + todayRow.outgoing : 0),
        (yestRow ? yestRow.incoming + yestRow.outgoing : 0));
      setDelta('delta-people',
        (todayRow?.startedConvos ?? 0),
        (yestRow?.startedConvos ?? 0));

      renderPeriods(data.periods);
      lastGeneratedMs = Date.parse(data.generatedAtISO);
      updateLastUpdated();
      if (relativeTimer) window.clearInterval(relativeTimer);
      relativeTimer = window.setInterval(updateLastUpdated, 30_000);

      document.getElementById('cutoff-label')!.textContent = fmtDateShort(data.cutoffISO);
      const dbg = data.debug;
      if (dbg) {
        const oldest = dbg.oldestFetchedISO ? fmtDate(Date.parse(dbg.oldestFetchedISO)) : '—';
        const warn = dbg.hitPageCap ? ' ⚠️ ATINGIU LIMITE — dados incompletos' : (dbg.uazapiHasMore ? ' ⚠️ Uazapi diz que há mais dados' : '');
        document.getElementById('debug-note')!.textContent =
          `${dbg.totalMessagesFetched} msgs em ${dbg.pagesFetched} páginas · mais antiga: ${oldest}${warn}`;
      }
      renderPeaks(data.peaks);
      renderRecent(data.recent);

      // Trigger reveal after DOM commit so transitions fire
      if (isFirstLoad) {
        requestAnimationFrame(() => {
          requestAnimationFrame(() => content.classList.add('revealed'));
        });
      } else {
        content.classList.add('revealed');
      }
    }

    function renderPeriods(periods: StatsResponse['periods']) {
      const body = document.getElementById('periods-body')!;
      body.innerHTML = '';
      const maxMsgs = Math.max(1, ...periods.map(p => p.messages));
      periods.forEach(p => {
        const tr = document.createElement('tr');
        const isTotal = p.label === 'Total';
        if (isTotal) tr.className = 'period-row-total';
        const fill = Math.max(0.02, p.messages / maxMsgs);
        tr.innerHTML = `
          <td style="padding:1rem"><span class="period-label">${escapeHtml(p.label)}</span></td>
          <td style="padding:1rem">
            <div class="period-msg-cell">
              <span class="period-num">${fmtInt(p.messages)}</span>
              <span class="period-bar" aria-hidden="true"><span class="period-bar-fill" style="--fill:${fill.toFixed(3)}"></span></span>
            </div>
          </td>
          <td style="padding:1rem;text-align:right"><span class="period-num period-num--muted">${fmtInt(p.newContacts)}</span></td>
          <td style="padding:1rem;text-align:right"><span class="period-num period-num--muted">${fmtInt(p.activeContacts)}</span></td>
        `;
        body.appendChild(tr);
      });
    }

    function renderPeaks(peaks: StatsResponse['peaks']) {
      const DAYS_LONG = ['domingo', 'segunda', 'terça', 'quarta', 'quinta', 'sexta', 'sábado'];
      const DAYS_SHORT = ['Dom', 'Seg', 'Ter', 'Qua', 'Qui', 'Sex', 'Sáb'];

      // Hour labels (0, 6, 12, 18)
      const hoursEl = document.getElementById('peaks-hours')!;
      hoursEl.innerHTML = '';
      for (let h = 0; h < 24; h++) {
        const cell = document.createElement('div');
        cell.textContent = (h % 6 === 0) ? String(h).padStart(2, '0') : '';
        hoursEl.appendChild(cell);
      }

      // Day labels
      const daysEl = document.getElementById('peaks-days')!;
      daysEl.innerHTML = '';
      for (const d of DAYS_SHORT) {
        const cell = document.createElement('div');
        cell.textContent = d;
        daysEl.appendChild(cell);
      }

      // Grid: 7 rows × 24 cols
      const gridEl = document.getElementById('peaks-grid')!;
      gridEl.innerHTML = '';
      const max = peaks.maxCell || 1;
      for (let d = 0; d < 7; d++) {
        for (let h = 0; h < 24; h++) {
          const value = peaks.grid[d][h] || 0;
          const intensity = value === 0 ? 0.04 : (0.15 + (value / max) * 0.8);
          const cell = document.createElement('div');
          cell.style.cssText = `height:22px;border-radius:3px;background:rgba(184,134,11,${intensity});border:1px solid rgba(184,134,11,0.08);cursor:default;transition:transform .12s`;
          cell.title = `${DAYS_LONG[d]}, ${String(h).padStart(2,'0')}h — ${value} mensagem${value === 1 ? '' : 's'} recebida${value === 1 ? '' : 's'}`;
          cell.setAttribute('aria-label', cell.title);
          cell.addEventListener('mouseenter', () => { cell.style.transform = 'scale(1.15)'; });
          cell.addEventListener('mouseleave', () => { cell.style.transform = ''; });
          gridEl.appendChild(cell);
        }
      }

      // Subtitle: top hour + totals
      const sub = document.getElementById('peaks-sub')!;
      const t = peaks.topHour;
      if (t.count > 0) {
        sub.textContent = `Pico: ${DAYS_LONG[t.day]} às ${String(t.hour).padStart(2,'0')}h (${t.count} msgs) · Total: ${peaks.totalIncoming} recebidas · ${peaks.totalOutgoing} enviadas`;
      } else {
        sub.textContent = 'Sem dados suficientes ainda.';
      }
    }

    function renderRecent(recent: StatsResponse['recent']) {
      const body = document.getElementById('recent-body')!;
      body.innerHTML = '';
      if (recent.length === 0) {
        body.innerHTML = '<tr><td colspan="5" style="padding:2rem 1rem;text-align:center;color:rgba(245,239,228,.35)">Sem atividade no período.</td></tr>';
        return;
      }
      const activeCutoff = Date.now() - 24 * 60 * 60 * 1000;
      recent.forEach(c => {
        const tr = document.createElement('tr');
        const phone = c.chatid.split('@')[0];
        const initial = (c.name.match(/[A-Za-zÀ-ÿ]/) || ['?'])[0].toUpperCase();
        const hue = hueFromString(c.chatid);
        const active = c.lastMsgAt >= activeCutoff ? '1' : '0';
        tr.innerHTML = `
          <td style="padding:1rem">
            <div class="contact-cell">
              <div class="contact-avatar" style="--h:${hue}" data-active="${active}" aria-hidden="true">${initial}</div>
              <div>
                <div class="td-name">${escapeHtml(c.name)}</div>
                <div class="td-phone">${escapeHtml(phoneFromChatId(c.chatid))}</div>
              </div>
            </div>
          </td>
          <td style="padding:1rem">
            <div class="td-count">${c.msgsTotal}</div>
            <div class="td-msgs-detail">↓${c.msgsIn} ↑${c.msgsOut}</div>
          </td>
          <td class="td-date" style="padding:1rem">${fmtDate(c.lastMsgAt)}</td>
          <td class="td-date" style="padding:1rem">${fmtDate(c.firstMsgAt)}</td>
          <td style="padding:1rem">
            <button
              data-phone="${escapeHtml(phone)}"
              data-action="${c.optedOut ? 'remove' : 'add'}"
              class="optout-toggle admin-btn admin-btn-sm ${c.optedOut ? 'admin-btn-optout-active' : 'admin-btn-optout'}"
            >${c.optedOut ? '✓ Opt-out' : 'Marcar opt-out'}</button>
          </td>`;
        body.appendChild(tr);
      });
      body.querySelectorAll<HTMLButtonElement>('.optout-toggle').forEach(btn => {
        btn.addEventListener('click', () => toggleOptOut(btn));
      });
    }

    async function toggleOptOut(btn: HTMLButtonElement) {
      const phone = btn.dataset.phone!;
      const action = btn.dataset.action as 'add' | 'remove';
      btn.disabled = true;
      try {
        const res = await fetch('/api/admin/optouts', {
          method: 'POST',
          credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ phone, action }),
        });
        if (!res.ok) throw new Error('falha');
        await Promise.all([loadStats(), loadOptOuts()]);
      } catch (err) {
        alert('Erro ao atualizar opt-out: ' + (err instanceof Error ? err.message : String(err)));
        btn.disabled = false;
      }
    }

    async function loadOptOuts() {
      const res = await fetch('/api/admin/optouts', { credentials: 'same-origin' });
      if (!res.ok) return;
      const data = await res.json() as { optouts: string[]; count: number };
      const container = document.getElementById('optout-list')!;
      container.innerHTML = '';
      if (data.optouts.length === 0) {
        container.innerHTML = '<div style="font-size:.8125rem;color:rgba(245,239,228,.35)">Nenhum opt-out registrado.</div>';
        return;
      }
      data.optouts.forEach(phone => {
        const row = document.createElement('div');
        row.className = 'optout-row';
        row.innerHTML = `
          <span>+${escapeHtml(phone)}</span>
          <button data-phone="${escapeHtml(phone)}" class="optout-remove admin-btn admin-btn-sm admin-btn-danger">Remover</button>`;
        container.appendChild(row);
      });
      container.querySelectorAll<HTMLButtonElement>('.optout-remove').forEach(btn => {
        btn.addEventListener('click', async () => {
          btn.disabled = true;
          await fetch('/api/admin/optouts', {
            method: 'POST', credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ phone: btn.dataset.phone, action: 'remove' }),
          });
          await Promise.all([loadStats(), loadOptOuts()]);
        });
      });
    }

    document.getElementById('refresh-btn')?.addEventListener('click', () => {
      const btn = document.getElementById('refresh-btn') as HTMLButtonElement;
      btn.style.opacity = '0.5';
      Promise.all([loadStats(), loadOptOuts()]).finally(() => { btn.style.opacity = ''; });
    });
    document.getElementById('logout-btn')?.addEventListener('click', async () => {
      await fetch('/api/admin/logout', { method: 'POST', credentials: 'same-origin' });
      window.location.href = '/admin-login';
    });
    document.getElementById('optout-add')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const input = document.getElementById('optout-phone') as HTMLInputElement;
      const phone = input.value.replace(/\D/g, '');
      if (!phone) return;
      const btn = (e.target as HTMLFormElement).querySelector('button')!;
      btn.disabled = true;
      await fetch('/api/admin/optouts', {
        method: 'POST', credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ phone, action: 'add' }),
      });
      input.value = '';
      btn.disabled = false;
      await Promise.all([loadStats(), loadOptOuts()]);
    });

    loadStats();
    loadOptOuts();
  </script>
</Base>

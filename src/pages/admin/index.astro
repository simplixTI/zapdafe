---
import Base from '../../layouts/Base.astro';
---
<Base title="Painel — Zapdafé Admin" description="Estatísticas e opt-outs">
  <Fragment slot="head">
    <meta name="robots" content="noindex, nofollow" />
    <style>
      /* Dark warm override for admin page only */
      body {
        background: #141210 !important;
        color: #F5EFE4 !important;
      }
    </style>
  </Fragment>

  <div class="admin-shell">
    <!-- Background -->
    <div class="admin-bg" aria-hidden="true">
      <div class="admin-bg-orb orb-1"></div>
      <div class="admin-bg-orb orb-2"></div>
    </div>

    <!-- Header -->
    <header class="admin-header">
      <div class="admin-header-inner">
        <div class="admin-brand">
          <img src="/logo.svg" alt="Zapdafé" class="admin-logo" />
          <span class="admin-brand-sep">/</span>
          <span class="admin-brand-label">Admin</span>
        </div>
        <div class="admin-header-actions">
          <button id="refresh-btn" class="admin-btn admin-btn-ghost" aria-label="Atualizar dados">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
            Atualizar
          </button>
          <button id="logout-btn" class="admin-btn admin-btn-ghost" aria-label="Sair do painel">
            Sair
          </button>
        </div>
      </div>
    </header>

    <main class="admin-main">
      <!-- Page title -->
      <div class="admin-page-title">
        <div>
          <h1 class="admin-h1">Painel</h1>
          <p id="last-updated" class="admin-subtitle">Carregando…</p>
        </div>
        <a href="#optouts" class="admin-link-subtle">
          Ir para opt-outs
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
        </a>
      </div>

      <!-- States -->
      <div id="loading" class="admin-loading" role="status" aria-live="polite">
        <div class="admin-spinner" aria-hidden="true"></div>
        Buscando dados do Uazapi…
      </div>
      <div id="error" class="admin-error hidden" role="alert"></div>

      <!-- Content -->
      <div id="content" class="hidden admin-content">

        <!-- Totals (cumulative, never shrink) -->
        <section aria-labelledby="totals-h">
          <h2 id="totals-h" class="sr-only">Totais acumulados</h2>
          <div class="totals-grid">
            <div class="total-card total-card--gold">
              <div class="total-icon" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
              </div>
              <div class="total-label">Pessoas atendidas</div>
              <div class="total-value" id="total-people">–</div>
              <div class="total-hint">acumulado</div>
            </div>
            <div class="total-card total-card--green">
              <div class="total-icon" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
              </div>
              <div class="total-label">Mensagens trocadas</div>
              <div class="total-value" id="total-messages">–</div>
              <div class="total-hint">acumulado</div>
            </div>
            <div class="total-card">
              <div class="total-icon" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg>
              </div>
              <div class="total-label">Opt-outs</div>
              <div class="total-value" id="total-optouts">–</div>
              <div class="total-hint">saíram da lista</div>
            </div>
          </div>
        </section>

        <!-- Períodos -->
        <section aria-labelledby="periods-h">
          <div class="admin-section-header">
            <h2 id="periods-h" class="admin-h2">Por período</h2>
          </div>
          <div class="table-card">
            <div class="table-wrap">
              <table class="admin-table periods-table">
                <thead>
                  <tr>
                    <th>Período</th>
                    <th class="th-num">Mensagens</th>
                    <th class="th-num">Pessoas novas</th>
                    <th class="th-num">Pessoas ativas</th>
                  </tr>
                </thead>
                <tbody id="periods-body"></tbody>
              </table>
            </div>
          </div>
        </section>

        <!-- Peaks heatmap -->
        <section aria-labelledby="peaks-h">
          <div class="admin-section-header">
            <div>
              <h2 id="peaks-h" class="admin-h2">Picos por horário</h2>
              <p class="peaks-sub" id="peaks-sub">–</p>
            </div>
          </div>
          <div class="peaks-card">
            <div class="peaks-header">
              <div class="peaks-corner"></div>
              <div class="peaks-hours" id="peaks-hours"></div>
            </div>
            <div class="peaks-body">
              <div class="peaks-days" id="peaks-days"></div>
              <div class="peaks-grid" id="peaks-grid" role="img" aria-label="Heatmap de mensagens recebidas por dia da semana e hora"></div>
            </div>
            <div class="peaks-scale">
              <span>Menos</span>
              <div class="peaks-scale-gradient"></div>
              <span>Mais</span>
            </div>
          </div>
        </section>

        <!-- Recent -->
        <section aria-labelledby="recent-h">
          <div class="admin-section-header">
            <h2 id="recent-h" class="admin-h2">Últimas atividades</h2>
          </div>
          <div class="table-card">
            <div class="table-wrap">
              <table class="admin-table">
                <thead>
                  <tr>
                    <th>Contato</th>
                    <th>Mensagens</th>
                    <th>Última</th>
                    <th>Iniciou</th>
                    <th>Ação</th>
                  </tr>
                </thead>
                <tbody id="recent-body"></tbody>
              </table>
            </div>
          </div>
        </section>

        <!-- Opt-outs -->
        <section id="optouts" aria-labelledby="optouts-h">
          <div class="admin-section-header">
            <h2 id="optouts-h" class="admin-h2">Opt-outs</h2>
          </div>
          <div class="glass-card">
            <form id="optout-add" class="optout-form">
              <input
                type="text"
                id="optout-phone"
                placeholder="55DD9XXXXXXXX (só dígitos)"
                class="admin-input"
                autocomplete="off"
                inputmode="numeric"
              />
              <button type="submit" class="admin-btn admin-btn-primary">
                Adicionar opt-out
              </button>
            </form>
            <div id="optout-list" class="optout-list"></div>
          </div>
        </section>

        <p class="admin-footer-note">
          Filtro ativo: mensagens desde <strong id="cutoff-label">–</strong>.
        </p>
        <p class="admin-footer-note" id="debug-note" style="opacity:.5"></p>
      </div>
    </main>
  </div>

  <style>
    /* ── Reset / base ───────────────────────────────── */
    .sr-only { position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0 }

    /* ── Shell & background ─────────────────────────── */
    .admin-shell {
      position: relative;
      min-height: 100vh;
      background: #141210;
      overflow-x: hidden;
    }
    .admin-bg {
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 0;
    }
    .admin-bg-orb {
      position: absolute;
      border-radius: 50%;
      filter: blur(120px);
      opacity: 0.18;
    }
    .orb-1 {
      width: 600px; height: 600px;
      background: radial-gradient(circle, #B8860B 0%, transparent 70%);
      top: -200px; right: -100px;
    }
    .orb-2 {
      width: 500px; height: 500px;
      background: radial-gradient(circle, #25D366 0%, transparent 70%);
      bottom: -100px; left: -150px;
    }

    /* ── Header ─────────────────────────────────────── */
    .admin-header {
      position: sticky;
      top: 0;
      z-index: 30;
      background: rgba(20, 18, 16, 0.75);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border-bottom: 1px solid rgba(184, 134, 11, 0.2);
    }
    .admin-header-inner {
      max-width: 1280px;
      margin: 0 auto;
      padding: 0 1.5rem;
      height: 64px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .admin-brand {
      display: flex;
      align-items: center;
      gap: 0.625rem;
    }
    .admin-logo {
      height: 32px;
      width: auto;
      filter: brightness(0) invert(1);
      opacity: 0.9;
    }
    .admin-brand-sep {
      color: rgba(245, 239, 228, 0.25);
      font-size: 1rem;
    }
    .admin-brand-label {
      font-size: 0.8125rem;
      font-weight: 500;
      color: rgba(245, 239, 228, 0.45);
      letter-spacing: 0.04em;
    }
    .admin-header-actions {
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    /* ── Buttons ─────────────────────────────────────── */
    .admin-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.375rem;
      font-size: 0.8125rem;
      font-weight: 500;
      padding: 0.4375rem 0.875rem;
      border-radius: 999px;
      cursor: pointer;
      transition: all 0.18s ease;
      border: none;
      text-decoration: none;
    }
    .admin-btn:focus-visible {
      outline: 2px solid #B8860B;
      outline-offset: 2px;
    }
    .admin-btn-ghost {
      background: rgba(245, 239, 228, 0.06);
      color: rgba(245, 239, 228, 0.6);
      border: 1px solid rgba(245, 239, 228, 0.1);
    }
    .admin-btn-ghost:hover {
      background: rgba(245, 239, 228, 0.1);
      color: #F5EFE4;
      border-color: rgba(245, 239, 228, 0.2);
    }
    .admin-btn-primary {
      background: #B8860B;
      color: #141210;
      font-weight: 600;
    }
    .admin-btn-primary:hover {
      background: #D4A017;
    }
    .admin-btn-sm {
      font-size: 0.75rem;
      padding: 0.3125rem 0.75rem;
    }
    .admin-btn-danger {
      background: rgba(239, 68, 68, 0.1);
      color: #FCA5A5;
      border: 1px solid rgba(239, 68, 68, 0.25);
    }
    .admin-btn-danger:hover {
      background: rgba(239, 68, 68, 0.2);
    }
    .admin-btn-optout {
      background: rgba(184, 134, 11, 0.12);
      color: #D4A017;
      border: 1px solid rgba(184, 134, 11, 0.3);
    }
    .admin-btn-optout:hover {
      background: rgba(184, 134, 11, 0.22);
    }
    .admin-btn-optout-active {
      background: rgba(184, 134, 11, 0.25);
      color: #F5EFE4;
      border: 1px solid rgba(184, 134, 11, 0.5);
    }

    /* ── Main layout ─────────────────────────────────── */
    .admin-main {
      position: relative;
      z-index: 1;
      max-width: 1280px;
      margin: 0 auto;
      padding: 2.5rem 1.5rem 4rem;
    }

    /* ── Page title ──────────────────────────────────── */
    .admin-page-title {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 1rem;
      margin-bottom: 2rem;
    }
    .admin-h1 {
      font-family: "Fraunces", serif;
      font-weight: 700;
      font-size: clamp(1.75rem, 4vw, 2.5rem);
      color: #F5EFE4;
      line-height: 1.1;
    }
    .admin-subtitle {
      font-size: 0.75rem;
      color: rgba(245, 239, 228, 0.4);
      margin-top: 0.25rem;
    }
    .admin-link-subtle {
      display: inline-flex;
      align-items: center;
      gap: 0.25rem;
      font-size: 0.8125rem;
      color: rgba(245, 239, 228, 0.4);
      text-decoration: none;
      transition: color 0.15s;
      white-space: nowrap;
      margin-top: 0.5rem;
    }
    .admin-link-subtle:hover { color: #B8860B; }

    /* ── Loading / error ─────────────────────────────── */
    .admin-loading {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      color: rgba(245, 239, 228, 0.45);
      font-size: 0.875rem;
      padding: 2rem 0;
    }
    .admin-spinner {
      width: 18px; height: 18px;
      border: 2px solid rgba(184, 134, 11, 0.2);
      border-top-color: #B8860B;
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
    }
    @keyframes spin { to { transform: rotate(360deg); } }

    .admin-error {
      background: rgba(239, 68, 68, 0.08);
      border: 1px solid rgba(239, 68, 68, 0.25);
      border-radius: 1rem;
      padding: 1rem 1.25rem;
      color: #FCA5A5;
      font-size: 0.875rem;
    }

    /* ── Content spacing ─────────────────────────────── */
    .admin-content { display: flex; flex-direction: column; gap: 2.5rem; }

    /* ── Section headers ─────────────────────────────── */
    .admin-section-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 0.875rem;
    }
    .admin-h2 {
      font-family: "Fraunces", serif;
      font-weight: 700;
      font-size: 1.125rem;
      color: #F5EFE4;
    }

    /* ── Glass card base ─────────────────────────────── */
    .glass-card {
      background: rgba(245, 239, 228, 0.04);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(184, 134, 11, 0.2);
      border-radius: 1.25rem;
      padding: 1.5rem;
    }

    /* ── Totals grid (cumulative) ────────────────────── */
    .totals-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 0.875rem;
    }
    @media (min-width: 640px) { .totals-grid { grid-template-columns: repeat(3, 1fr); } }

    .total-card {
      position: relative;
      background: rgba(245, 239, 228, 0.05);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
      border: 1px solid rgba(184, 134, 11, 0.2);
      border-radius: 1.25rem;
      padding: 1.5rem 1.5rem 1.375rem;
      overflow: hidden;
    }
    .total-card::after {
      content: '';
      position: absolute;
      top: 0; right: 0;
      width: 80px; height: 80px;
      background: radial-gradient(circle at top right, rgba(184,134,11,0.15), transparent 70%);
      pointer-events: none;
    }
    .total-card--gold {
      border-color: rgba(184, 134, 11, 0.4);
      background: linear-gradient(135deg, rgba(184,134,11,0.09), rgba(245,239,228,0.03));
    }
    .total-card--green {
      border-color: rgba(37, 211, 102, 0.28);
      background: linear-gradient(135deg, rgba(37,211,102,0.06), rgba(245,239,228,0.03));
    }
    .total-card--green::after {
      background: radial-gradient(circle at top right, rgba(37,211,102,0.15), transparent 70%);
    }
    .total-icon {
      display: inline-flex;
      color: rgba(184, 134, 11, 0.75);
      margin-bottom: 0.75rem;
      padding: 0.5rem;
      background: rgba(184, 134, 11, 0.08);
      border-radius: 0.625rem;
    }
    .total-card--green .total-icon { color: rgba(37, 211, 102, 0.85); background: rgba(37, 211, 102, 0.08); }
    .total-label {
      font-size: 0.75rem;
      color: rgba(245, 239, 228, 0.55);
      text-transform: uppercase;
      letter-spacing: 0.06em;
      font-weight: 500;
    }
    .total-value {
      font-family: "Fraunces", serif;
      font-weight: 700;
      font-size: clamp(2.25rem, 5vw, 3rem);
      line-height: 1;
      color: #F5EFE4;
      margin-top: 0.375rem;
    }
    .total-hint {
      font-size: 0.6875rem;
      color: rgba(245, 239, 228, 0.35);
      margin-top: 0.5rem;
      font-style: italic;
    }

    /* ── Periods table ───────────────────────────────── */
    .periods-table th.th-num, .periods-table td.td-num {
      text-align: right;
    }
    .period-label {
      font-weight: 600;
      color: #F5EFE4;
      font-size: 0.9rem;
    }
    .period-num {
      font-family: "Fraunces", serif;
      font-weight: 700;
      font-size: 1.125rem;
      color: #F5EFE4;
    }
    .period-num--muted { color: rgba(245,239,228,0.5); font-size: 1rem; }
    .period-row-total {
      background: rgba(184, 134, 11, 0.06) !important;
    }
    .period-row-total .period-label { color: #D4A017; }
    .period-row-total .period-num { color: #D4A017; }

    /* ── KPI grid ─────────────────────────────────────── */
    .kpi-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 0.75rem;
    }
    @media (min-width: 640px) { .kpi-grid { grid-template-columns: repeat(3, 1fr); } }
    @media (min-width: 1024px) { .kpi-grid { grid-template-columns: repeat(6, 1fr); } }

    .kpi-card {
      background: rgba(245, 239, 228, 0.04);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(184, 134, 11, 0.15);
      border-radius: 1rem;
      padding: 1rem 1rem 1.125rem;
      transition: border-color 0.2s, background 0.2s;
    }
    .kpi-card:hover {
      border-color: rgba(184, 134, 11, 0.35);
      background: rgba(245, 239, 228, 0.07);
    }
    .kpi-card--highlight {
      border-color: rgba(184, 134, 11, 0.4);
      background: rgba(184, 134, 11, 0.07);
    }
    .kpi-card--highlight:hover {
      background: rgba(184, 134, 11, 0.12);
    }

    .kpi-icon {
      display: inline-flex;
      padding: 0.25rem;
      color: rgba(184, 134, 11, 0.7);
      margin-bottom: 0.625rem;
    }
    .kpi-icon--green { color: rgba(37, 211, 102, 0.7); }
    .kpi-icon--muted { color: rgba(245, 239, 228, 0.25); }

    .kpi-label {
      font-size: 0.6875rem;
      color: rgba(245, 239, 228, 0.4);
      text-transform: uppercase;
      letter-spacing: 0.07em;
      font-weight: 500;
    }
    .kpi-value {
      font-family: "Fraunces", serif;
      font-weight: 700;
      font-size: 2rem;
      line-height: 1.05;
      color: #F5EFE4;
      margin-top: 0.125rem;
    }
    .kpi-value--green { color: #25D366; }

    /* ── Peaks heatmap ───────────────────────────────── */
    .peaks-card {
      background: rgba(245, 239, 228, 0.04);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(184, 134, 11, 0.15);
      border-radius: 1.25rem;
      padding: 1.5rem;
    }
    .peaks-sub {
      font-size: 0.75rem;
      color: rgba(245, 239, 228, 0.4);
      margin-top: 0.25rem;
    }
    .peaks-header {
      display: grid;
      grid-template-columns: 44px 1fr;
      margin-bottom: 6px;
    }
    .peaks-corner {}
    .peaks-hours {
      display: grid;
      grid-template-columns: repeat(24, 1fr);
      font-size: 0.625rem;
      color: rgba(245, 239, 228, 0.35);
      text-align: center;
    }
    .peaks-body {
      display: grid;
      grid-template-columns: 44px 1fr;
      gap: 8px;
    }
    .peaks-days {
      display: grid;
      grid-template-rows: repeat(7, 1fr);
      font-size: 0.6875rem;
      color: rgba(245, 239, 228, 0.5);
      text-align: right;
      align-items: center;
      gap: 3px;
    }
    .peaks-grid {
      display: grid;
      grid-template-columns: repeat(24, 1fr);
      grid-template-rows: repeat(7, 1fr);
      gap: 3px;
    }
    .peaks-scale {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-top: 1rem;
      font-size: 0.625rem;
      color: rgba(245, 239, 228, 0.35);
      justify-content: flex-end;
    }
    .peaks-scale-gradient {
      width: 90px;
      height: 8px;
      border-radius: 4px;
      background: linear-gradient(to right, rgba(184,134,11,0.08), rgba(184,134,11,0.9));
    }

    /* ── Table ───────────────────────────────────────── */
    .table-card {
      background: rgba(245, 239, 228, 0.04);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(184, 134, 11, 0.15);
      border-radius: 1.25rem;
      overflow: hidden;
    }
    .table-wrap { overflow-x: auto; }
    .admin-table {
      width: 100%;
      font-size: 0.8125rem;
      border-collapse: collapse;
    }
    .admin-table thead tr {
      border-bottom: 1px solid rgba(184, 134, 11, 0.15);
    }
    .admin-table th {
      padding: 0.75rem 1rem;
      text-align: left;
      font-size: 0.6875rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.07em;
      color: rgba(245, 239, 228, 0.35);
    }
    .admin-table tbody tr {
      border-bottom: 1px solid rgba(184, 134, 11, 0.18);
      transition: background 0.15s;
    }
    .admin-table tbody tr:last-child { border-bottom: none; }
    .admin-table tbody tr:hover { background: rgba(184, 134, 11, 0.07); }
    .admin-table td {
      padding: 1rem 1rem;
      color: #F5EFE4;
      vertical-align: middle;
    }
    /* Avatar + contact cell */
    .contact-cell {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }
    .contact-avatar {
      flex-shrink: 0;
      width: 36px; height: 36px;
      border-radius: 50%;
      background: rgba(184, 134, 11, 0.14);
      border: 1px solid rgba(184, 134, 11, 0.35);
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: "Fraunces", serif;
      font-weight: 700;
      font-size: 0.875rem;
      color: #D4A017;
      line-height: 1;
      user-select: none;
    }
    .td-name {
      font-weight: 600;
      font-size: 0.875rem;
      line-height: 1.3;
      color: #F5EFE4;
    }
    .td-phone {
      font-size: 0.6875rem;
      color: rgba(245,239,228,0.35);
      margin-top: 0.25rem;
      letter-spacing: 0.01em;
    }
    .td-count {
      font-size: 1rem;
      font-weight: 600;
      color: #F5EFE4;
    }
    .td-msgs-detail {
      font-size: 0.6875rem;
      color: rgba(245,239,228,0.35);
      margin-top: 0.25rem;
      letter-spacing: 0.02em;
    }
    .td-date {
      font-size: 0.75rem;
      color: rgba(245,239,228,0.5);
      line-height: 1.6;
    }

    /* ── Opt-outs form ───────────────────────────────── */
    .optout-form {
      display: flex;
      flex-direction: column;
      gap: 0.625rem;
      margin-bottom: 1.25rem;
    }
    @media (min-width: 540px) { .optout-form { flex-direction: row; } }

    .admin-input {
      flex: 1;
      background: rgba(245, 239, 228, 0.05);
      border: 1px solid rgba(184, 134, 11, 0.2);
      border-radius: 0.75rem;
      padding: 0.6875rem 1rem;
      font-size: 0.875rem;
      color: #F5EFE4;
      outline: none;
      transition: border-color 0.15s, background 0.15s;
    }
    .admin-input::placeholder { color: rgba(245, 239, 228, 0.25); }
    .admin-input:focus {
      border-color: rgba(184, 134, 11, 0.6);
      background: rgba(245, 239, 228, 0.08);
    }

    .optout-list { display: flex; flex-direction: column; gap: 0.375rem; }
    .optout-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0.5rem 0.875rem;
      border-radius: 0.625rem;
      background: rgba(245, 239, 228, 0.04);
      border: 1px solid rgba(245, 239, 228, 0.08);
      font-family: monospace;
      font-size: 0.8125rem;
      color: rgba(245, 239, 228, 0.75);
    }

    /* ── Footer note ─────────────────────────────────── */
    .admin-footer-note {
      font-size: 0.75rem;
      color: rgba(245, 239, 228, 0.3);
      text-align: center;
      padding-top: 1rem;
    }

    /* ── Responsive ──────────────────────────────────── */
    @media (max-width: 480px) {
      .admin-main { padding: 1.5rem 1rem 3rem; }
      .admin-page-title { flex-direction: column; gap: 0.5rem; }
      .kpi-value { font-size: 1.625rem; }
    }

    /* ── Reduced motion ──────────────────────────────── */
    @media (prefers-reduced-motion: reduce) {
      .admin-spinner { animation: none; border-top-color: #B8860B; }
      * { transition-duration: 0ms !important; }
    }
  </style>

  <script>
    interface StatsResponse {
      cutoffISO: string;
      generatedAtISO: string;
      totals: {
        peopleEver: number;
        messagesEver: number;
        optedOutCount: number;
      };
      periods: Array<{
        label: string;
        messages: number;
        newContacts: number;
        activeContacts: number;
      }>;
      people: {
        total: number;
        activeLast24h: number;
        activeLast7d: number;
        activeLast30d: number;
        startedToday: number;
        optedOutCount: number;
      };
      messages: {
        totalSinceCutoff: number;
        today: number;
        last7d: number;
        last30d: number;
        incomingToday: number;
        outgoingToday: number;
      };
      daily: Array<{ date: string; incoming: number; outgoing: number; startedConvos: number }>;
      peaks: {
        grid: number[][];
        maxCell: number;
        totalIncoming: number;
        totalOutgoing: number;
        topHour: { day: number; hour: number; count: number };
      };
      debug?: {
        pagesFetched: number;
        hitPageCap: boolean;
        uazapiHasMore: boolean;
        totalMessagesFetched: number;
        oldestFetchedISO: string | null;
      };
      recent: Array<{
        chatid: string;
        name: string;
        firstMsgAt: number;
        lastMsgAt: number;
        msgsIn: number;
        msgsOut: number;
        msgsTotal: number;
        optedOut: boolean;
      }>;
    }

    function fmtDate(ms: number): string {
      return new Date(ms).toLocaleString('pt-BR', { timeZone: 'America/Sao_Paulo', dateStyle: 'short', timeStyle: 'short' });
    }
    function fmtDateShort(iso: string): string {
      return new Date(iso).toLocaleDateString('pt-BR', { timeZone: 'America/Sao_Paulo', day: '2-digit', month: '2-digit' });
    }
    function phoneFromChatId(chatid: string): string {
      const d = chatid.split('@')[0];
      if (d.length >= 12) return `+${d.slice(0,2)} ${d.slice(2,4)} ${d.slice(4)}`;
      return d;
    }
    function escapeHtml(s: string): string {
      return s.replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]!));
    }

    async function loadStats() {
      const loading = document.getElementById('loading')!;
      const errorEl = document.getElementById('error')!;
      const content = document.getElementById('content')!;
      loading.classList.remove('hidden');
      errorEl.classList.add('hidden');
      content.classList.add('hidden');
      try {
        const res = await fetch('/api/admin/stats', { credentials: 'same-origin' });
        if (res.status === 401) { window.location.href = '/admin-login'; return; }
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        renderStats(await res.json() as StatsResponse);
      } catch (err) {
        errorEl.textContent = 'Falha ao carregar estatísticas: ' + (err instanceof Error ? err.message : String(err));
        errorEl.classList.remove('hidden');
      } finally {
        loading.classList.add('hidden');
      }
    }

    function fmtInt(n: number): string {
      return n.toLocaleString('pt-BR');
    }

    function renderStats(data: StatsResponse) {
      document.getElementById('content')!.classList.remove('hidden');
      document.getElementById('total-people')!.textContent = fmtInt(data.totals.peopleEver);
      document.getElementById('total-messages')!.textContent = fmtInt(data.totals.messagesEver);
      document.getElementById('total-optouts')!.textContent = fmtInt(data.totals.optedOutCount);
      renderPeriods(data.periods);
      document.getElementById('last-updated')!.textContent = 'Atualizado ' + fmtDate(Date.parse(data.generatedAtISO));
      document.getElementById('cutoff-label')!.textContent = fmtDateShort(data.cutoffISO);
      const dbg = data.debug;
      if (dbg) {
        const oldest = dbg.oldestFetchedISO ? fmtDate(Date.parse(dbg.oldestFetchedISO)) : '—';
        const warn = dbg.hitPageCap ? ' ⚠️ ATINGIU LIMITE — dados incompletos' : (dbg.uazapiHasMore ? ' ⚠️ Uazapi diz que há mais dados' : '');
        document.getElementById('debug-note')!.textContent =
          `${dbg.totalMessagesFetched} msgs em ${dbg.pagesFetched} páginas · mais antiga: ${oldest}${warn}`;
      }
      renderPeaks(data.peaks);
      renderRecent(data.recent);
    }

    function renderPeriods(periods: StatsResponse['periods']) {
      const body = document.getElementById('periods-body')!;
      body.innerHTML = '';
      periods.forEach(p => {
        const tr = document.createElement('tr');
        const isTotal = p.label === 'Total';
        if (isTotal) tr.className = 'period-row-total';
        tr.innerHTML = `
          <td style="padding:1rem"><span class="period-label">${escapeHtml(p.label)}</span></td>
          <td style="padding:1rem;text-align:right"><span class="period-num">${fmtInt(p.messages)}</span></td>
          <td style="padding:1rem;text-align:right"><span class="period-num period-num--muted">${fmtInt(p.newContacts)}</span></td>
          <td style="padding:1rem;text-align:right"><span class="period-num period-num--muted">${fmtInt(p.activeContacts)}</span></td>
        `;
        body.appendChild(tr);
      });
    }

    function renderPeaks(peaks: StatsResponse['peaks']) {
      const DAYS_LONG = ['domingo', 'segunda', 'terça', 'quarta', 'quinta', 'sexta', 'sábado'];
      const DAYS_SHORT = ['Dom', 'Seg', 'Ter', 'Qua', 'Qui', 'Sex', 'Sáb'];

      // Hour labels (0, 6, 12, 18)
      const hoursEl = document.getElementById('peaks-hours')!;
      hoursEl.innerHTML = '';
      for (let h = 0; h < 24; h++) {
        const cell = document.createElement('div');
        cell.textContent = (h % 6 === 0) ? String(h).padStart(2, '0') : '';
        hoursEl.appendChild(cell);
      }

      // Day labels
      const daysEl = document.getElementById('peaks-days')!;
      daysEl.innerHTML = '';
      for (const d of DAYS_SHORT) {
        const cell = document.createElement('div');
        cell.textContent = d;
        daysEl.appendChild(cell);
      }

      // Grid: 7 rows × 24 cols
      const gridEl = document.getElementById('peaks-grid')!;
      gridEl.innerHTML = '';
      const max = peaks.maxCell || 1;
      for (let d = 0; d < 7; d++) {
        for (let h = 0; h < 24; h++) {
          const value = peaks.grid[d][h] || 0;
          const intensity = value === 0 ? 0.04 : (0.15 + (value / max) * 0.8);
          const cell = document.createElement('div');
          cell.style.cssText = `height:22px;border-radius:3px;background:rgba(184,134,11,${intensity});border:1px solid rgba(184,134,11,0.08);cursor:default;transition:transform .12s`;
          cell.title = `${DAYS_LONG[d]}, ${String(h).padStart(2,'0')}h — ${value} mensagem${value === 1 ? '' : 's'} recebida${value === 1 ? '' : 's'}`;
          cell.setAttribute('aria-label', cell.title);
          cell.addEventListener('mouseenter', () => { cell.style.transform = 'scale(1.15)'; });
          cell.addEventListener('mouseleave', () => { cell.style.transform = ''; });
          gridEl.appendChild(cell);
        }
      }

      // Subtitle: top hour + totals
      const sub = document.getElementById('peaks-sub')!;
      const t = peaks.topHour;
      if (t.count > 0) {
        sub.textContent = `Pico: ${DAYS_LONG[t.day]} às ${String(t.hour).padStart(2,'0')}h (${t.count} msgs) · Total: ${peaks.totalIncoming} recebidas · ${peaks.totalOutgoing} enviadas`;
      } else {
        sub.textContent = 'Sem dados suficientes ainda.';
      }
    }

    function renderRecent(recent: StatsResponse['recent']) {
      const body = document.getElementById('recent-body')!;
      body.innerHTML = '';
      if (recent.length === 0) {
        body.innerHTML = '<tr><td colspan="5" style="padding:2rem 1rem;text-align:center;color:rgba(245,239,228,.35)">Sem atividade no período.</td></tr>';
        return;
      }
      recent.forEach(c => {
        const tr = document.createElement('tr');
        const phone = c.chatid.split('@')[0];
        const initial = (c.name.match(/[A-Za-zÀ-ÿ]/) || ['?'])[0].toUpperCase();
        tr.innerHTML = `
          <td style="padding:1rem">
            <div style="display:flex;align-items:center;gap:0.75rem">
              <div aria-hidden="true" style="flex-shrink:0;width:36px;height:36px;border-radius:50%;background:rgba(184,134,11,0.15);border:1px solid rgba(184,134,11,0.4);display:flex;align-items:center;justify-content:center;font-family:'Fraunces',serif;font-weight:700;font-size:0.9rem;color:#D4A017;line-height:1">${initial}</div>
              <div>
                <div style="font-weight:600;font-size:0.875rem;color:#F5EFE4;line-height:1.3">${escapeHtml(c.name)}</div>
                <div style="font-size:0.6875rem;color:rgba(245,239,228,0.38);margin-top:0.25rem;letter-spacing:0.01em">${escapeHtml(phoneFromChatId(c.chatid))}</div>
              </div>
            </div>
          </td>
          <td style="padding:1rem">
            <div style="font-size:1rem;font-weight:600;color:#F5EFE4">${c.msgsTotal}</div>
            <div style="font-size:0.6875rem;color:rgba(245,239,228,0.38);margin-top:0.25rem;letter-spacing:0.02em">↓${c.msgsIn} ↑${c.msgsOut}</div>
          </td>
          <td style="padding:1rem;font-size:0.75rem;color:rgba(245,239,228,0.55);line-height:1.6">${fmtDate(c.lastMsgAt)}</td>
          <td style="padding:1rem;font-size:0.75rem;color:rgba(245,239,228,0.55);line-height:1.6">${fmtDate(c.firstMsgAt)}</td>
          <td>
            <button
              data-phone="${escapeHtml(phone)}"
              data-action="${c.optedOut ? 'remove' : 'add'}"
              class="optout-toggle admin-btn admin-btn-sm ${c.optedOut ? 'admin-btn-optout-active' : 'admin-btn-optout'}"
            >${c.optedOut ? '✓ Opt-out' : 'Marcar opt-out'}</button>
          </td>`;
        body.appendChild(tr);
      });
      body.querySelectorAll<HTMLButtonElement>('.optout-toggle').forEach(btn => {
        btn.addEventListener('click', () => toggleOptOut(btn));
      });
    }

    async function toggleOptOut(btn: HTMLButtonElement) {
      const phone = btn.dataset.phone!;
      const action = btn.dataset.action as 'add' | 'remove';
      btn.disabled = true;
      try {
        const res = await fetch('/api/admin/optouts', {
          method: 'POST',
          credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ phone, action }),
        });
        if (!res.ok) throw new Error('falha');
        await Promise.all([loadStats(), loadOptOuts()]);
      } catch (err) {
        alert('Erro ao atualizar opt-out: ' + (err instanceof Error ? err.message : String(err)));
        btn.disabled = false;
      }
    }

    async function loadOptOuts() {
      const res = await fetch('/api/admin/optouts', { credentials: 'same-origin' });
      if (!res.ok) return;
      const data = await res.json() as { optouts: string[]; count: number };
      const container = document.getElementById('optout-list')!;
      container.innerHTML = '';
      if (data.optouts.length === 0) {
        container.innerHTML = '<div style="font-size:.8125rem;color:rgba(245,239,228,.35)">Nenhum opt-out registrado.</div>';
        return;
      }
      data.optouts.forEach(phone => {
        const row = document.createElement('div');
        row.className = 'optout-row';
        row.innerHTML = `
          <span>+${escapeHtml(phone)}</span>
          <button data-phone="${escapeHtml(phone)}" class="optout-remove admin-btn admin-btn-sm admin-btn-danger">Remover</button>`;
        container.appendChild(row);
      });
      container.querySelectorAll<HTMLButtonElement>('.optout-remove').forEach(btn => {
        btn.addEventListener('click', async () => {
          btn.disabled = true;
          await fetch('/api/admin/optouts', {
            method: 'POST', credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ phone: btn.dataset.phone, action: 'remove' }),
          });
          await Promise.all([loadStats(), loadOptOuts()]);
        });
      });
    }

    document.getElementById('refresh-btn')?.addEventListener('click', () => {
      const btn = document.getElementById('refresh-btn') as HTMLButtonElement;
      btn.style.opacity = '0.5';
      Promise.all([loadStats(), loadOptOuts()]).finally(() => { btn.style.opacity = ''; });
    });
    document.getElementById('logout-btn')?.addEventListener('click', async () => {
      await fetch('/api/admin/logout', { method: 'POST', credentials: 'same-origin' });
      window.location.href = '/admin-login';
    });
    document.getElementById('optout-add')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const input = document.getElementById('optout-phone') as HTMLInputElement;
      const phone = input.value.replace(/\D/g, '');
      if (!phone) return;
      const btn = (e.target as HTMLFormElement).querySelector('button')!;
      btn.disabled = true;
      await fetch('/api/admin/optouts', {
        method: 'POST', credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ phone, action: 'add' }),
      });
      input.value = '';
      btn.disabled = false;
      await Promise.all([loadStats(), loadOptOuts()]);
    });

    loadStats();
    loadOptOuts();
  </script>
</Base>
